# Copy to config.env and adjust before running setup scripts.
# config.env is git-ignored.

# 設定ファイルは既定で infra/config.env。環境変数 CONFIG_FILE で切り替えられる
# （例: 旧アカウント用と組織アカウント用を並べる）。
#   CONFIG_FILE=config.org.env ./setup.sh

AWS_REGION=ap-northeast-1

# 使う AWS CLI のプロファイル。コメントアウトしておけば、環境変数のクレデンシャル
# （AWS_ACCESS_KEY_ID など）または実行時の `AWS_PROFILE=xxx ./verify.sh` を使う。
# 書き込み用（Power User）と確認用（ReadOnly）を使い分けるときは、ここには書かず実行時に渡す。
#AWS_PROFILE=

# 実行先アカウントの ID（12 桁）。必須。クレデンシャルが指すアカウントと一致しなければ
# スクリプトは中断する（旧アカウントと組織アカウントの取り違え防止）。
EXPECTED_ACCOUNT_ID=

# IAM ロールを管理者が用意した場合の ARN（#98）。指定するとスクリプトはロールを作らず、
# そのロールをそのまま使う。Power User 権限では IAM ロールを作れないため。
# ロールの定義は docs/aws-admin-handoff.md を参照。
#LAMBDA_ROLE_ARN=arn:aws:iam::<account-id>:role/parking-status-bridge-lambda-role
#COGNITO_AUTH_ROLE_ARN=arn:aws:iam::<account-id>:role/parking-status-ios-app-authenticated
# 省略すると arn:aws:iam::<account-id>:role/service-role/IoTWirelessGatewayCertManagerRole
#LORAWAN_ROLE_ARN=

# Resource names (must match docs/iot-core.md)
IOT_POLICY_NAME=parking-status-device
IOT_RULE_NAME=parking_status_telemetry
LAMBDA_FUNCTION_NAME=parking-status-bridge
LAMBDA_ROLE_NAME=parking-status-bridge-lambda-role

# LoRaWAN (#40): IoT Core for LoRaWAN の Destination が publish するトピックを読むルール
IOT_LORAWAN_RULE_NAME=parking_status_lorawan
LORAWAN_UPLINK_TOPIC=lorawan/parking-status/uplink

# MQTT topic prefix (deviceId is appended)
MQTT_TOPIC_PREFIX=parking-status

# Use Basic Ingest topic for test-publish.sh and device provisioning hints
USE_BASIC_INGEST=1

# Cognito resources for the iOS log-viewer app (Issue #68)
COGNITO_USER_POOL_NAME=parking-status-ios-app
COGNITO_CLIENT_NAME=parking-status-ios-client
COGNITO_IDENTITY_POOL_NAME=parking_status_ios_app
COGNITO_AUTH_ROLE_NAME=parking-status-ios-app-authenticated
CLOUDWATCH_LOG_GROUP_NAME=/aws/lambda/parking-status-bridge

# Developer login for the iOS app (Cognito username = email)
IOS_APP_USER_EMAIL=kazuki@code4japan.org

# LoRaWAN (#40, #98): infra/setup-lorawan.sh
LORAWAN_SERVICE_PROFILE_NAME=parking-status
LORAWAN_DEVICE_PROFILE_NAME=AS923-1-A-OTAA
LORAWAN_DESTINATION_NAME=Saga_IoT_Core
LORAWAN_ROLE_NAME=IoTWirelessGatewayCertManagerRole
LORAWAN_GATEWAY_NAME="Saga Gateway"
# SenseCAP M2 の Gateway EUI（docs/40-lorawan-design.md）。他のアカウントに登録済みだと作れない。
LORAWAN_GATEWAY_EUI=2cf7f1138030000c
LORAWAN_GATEWAY_RF_REGION=AS923-1
# Wireless Device（端末）の DevEui / AppEui / AppKey は秘密を含むため config.env には書かず、
# `LORAWAN_DEV_EUI=... LORAWAN_APP_EUI=... ./setup-lorawan.sh device <deviceId>` のように
# 実行時に渡す（AppKey は未指定なら対話入力）。

# Device master (#7, #14): deviceId -> name / location. DynamoDB table (infra/setup-device-master.sh)
DEVICE_MASTER_TABLE=parking-status-device-master

# Orion (#7): Lambda の環境変数に設定される（infra/deploy-bridge-stub.sh）。
# ORION_URL が空なら Lambda は Orion に送らない（CloudWatch Logs への出力のみ）。空の項目は設定しない。
# config.env は Git 管理外。パスワードは Lambda の設定（環境変数）に入るので、Orion への書き込みだけ
# できる専用ユーザーの値を使う（個人アカウントの検証では検証用ユーザーを使う）。
#ORION_URL=https://orion.example.org
#ORION_FIWARE_SERVICE=
#ORION_FIWARE_SERVICEPATH=
# Orion のトークンは有効期限があるので、Lambda が送るたびに Cognito でログインして取る（リフレッシュしない）。
# ログインは SRP（USER_SRP_AUTH。パスワードそのものは送らない）。USER_POOL_ID / CLIENT_ID / USERNAME / PASSWORD の
# 4 つをそろえて設定する（リージョンは USER_POOL_ID の先頭から決まる）。すべて空なら認証ヘッダなしで送る。
#ORION_COGNITO_USER_POOL_ID=ap-northeast-1_xxxxxxxxx
#ORION_COGNITO_CLIENT_ID=
#ORION_COGNITO_USERNAME=
# パスワードはファイルに書かないことを勧める。空のままにすると、deploy-bridge-stub.sh が Lambda に設定済みの値を
# 引き継ぐか、端末で入力を求める（--ask-password で入力し直し）。書く場合はシングルクォートで囲む。
#ORION_COGNITO_PASSWORD=
# 省略可: クライアントシークレット付き App Client のとき / Orion が受け取るトークン（id か access。既定 id）
#ORION_COGNITO_CLIENT_SECRET=
#ORION_COGNITO_TOKEN_TYPE=
