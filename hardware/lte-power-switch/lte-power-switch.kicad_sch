	(text "LTE power switch  rev A  (#88)\nTI TPS22918DBVR load switch gates the LTE-M unit VCC (Grove pin3).\nGrove pin1/pin2 (UART) pass straight through J1 -> J2.\nLTE_EN: HIGH = ON. R1 pulls it LOW when the GPIO is Hi-Z (deep sleep, reset)."
		(exclude_from_sim no)
		(at 160.02 36 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "9a85cbf7-aef7-4cd4-95ba-ffa86b7c8f53")
	)
